{
  "namespace": "server_form",
  "dynamic_button": {
    "size": ["100%", "100%cm"],
    "min_size": ["100%", 32],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "rustbeds_details_label@server_form.rustbeds_details_label": {} }
        ]
      }
    ]
  },
  "dynamic_button/form_button": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "collection",
            "binding_collection_name": "form_buttons",
            "binding_name": "#form_button_text",
            "binding_name_override": "#rustbeds_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#rustbeds_text - '§r§0§r§0§r§0§r') = #rustbeds_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "rustbeds_details_label": {
    "type": "label",
    "size": ["fill", "default"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "#text",
    "text_alignment": "left",
    "shadow": true,
    "localize": false,
    "visible": false,
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "form_buttons",
        "binding_name": "#form_button_text",
        "binding_name_override": "#rustbeds_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#rustbeds_text - '§r§0§r§0§r§0§r') = #rustbeds_text))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#rustbeds_text - '§r§0§r§0§r§0§r')",
        "target_property_name": "#text"
      }
    ]
  }
}
